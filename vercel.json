{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth?a=login" },
    { "source": "/api/auth/callback", "destination": "/api/auth?a=callback" },
    { "source": "/api/auth/logout", "destination": "/api/auth?a=logout" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
